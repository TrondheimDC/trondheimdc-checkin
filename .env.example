# Optional. When set, the LibSQL file is encrypted at rest.
# The app still boots when this is empty (plaintext file).
DB_ENCRYPTION_KEY=

# Optional mount prefix behind nginx. No trailing slash. Example: /checkin
NEXT_PUBLIC_BASE_PATH=

# QL paper-size id passed as Smooth Print's `size` parameter.
# Official docs only exemplify DieCutW62H29, which is not DK-11208.
# Leave empty until the id is confirmed on hardware. The print button still works.
LABEL_PAPER_SIZE_ID=

# Android download for Smooth Print. Defaults to Brother's agreement page (a zip).
# Set this to a direct .apk URL if you host the file yourself.
SMOOTH_PRINT_ANDROID_URL=
