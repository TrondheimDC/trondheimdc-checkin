# Optional. When set, the LibSQL file is encrypted at rest.
# The app still boots when this is empty (plaintext file).
DB_ENCRYPTION_KEY=

# Optional mount prefix behind nginx. No trailing slash. Example: /checkin
NEXT_PUBLIC_BASE_PATH=

# QL paper-size id passed as Smooth Print's required `size` parameter.
# Default DieCutW38H90 is DK-11208 (38 × 90 mm). Override only if you change media.
LABEL_PAPER_SIZE_ID=DieCutW38H90

# Android download for Smooth Print when no APK is activated in admin.
# Defaults to Brother's agreement page. Admin → Smooth Print overrides this.
SMOOTH_PRINT_ANDROID_URL=
