# Optional. When set, the LibSQL file is encrypted at rest.
# The app still boots when this is empty (plaintext file).
DB_ENCRYPTION_KEY=

# Optional mount prefix behind nginx. No trailing slash. Example: /checkin
# Leave empty for https://innsjekk.trondheimdc.no at the domain root.
# Must be available at `next build` time if set (baked into the client).
NEXT_PUBLIC_BASE_PATH=

# Public origin encoded on printed stickers (setup + login QR). No trailing slash.
# Defaults to https://innsjekk.trondheimdc.no everywhere (including localhost).
PUBLIC_URL=

# better-auth (required in production)
BETTER_AUTH_SECRET=
# Public origin of this app, no trailing slash. Example: https://innsjekk.trondheimdc.no
BETTER_AUTH_URL=http://localhost:3000

# Dev only: extra origins allowed to call the auth API / load the dev server
# (comma-separated, e.g. a tunnel or preview host). Leave unset in production.
# BETTER_AUTH_TRUSTED_ORIGINS=https://preview.example.com
# ALLOWED_DEV_ORIGINS=preview.example.com

# Seeded on boot when both are set (super-admin). Password is not overwritten if the user exists.
# Username: letters, digits, underscore, or dot. Stored with a non-mailed placeholder email.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# ADMIN_NAME=Admin
